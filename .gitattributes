# 统一行尾，避免 Windows 上编辑后 shell 脚本带上 CRLF 导致 Linux 执行失败
* text=auto

*.sh        text eol=lf
*.service   text eol=lf
Dockerfile  text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows 批处理必须是 CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
